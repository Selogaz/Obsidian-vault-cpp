  "customRegexes": [
    {
      "label": "Em dash → en dash",
      "find": "(?=—)(?<=(?<![\\s\\S])(?:---[ \\t]*\\r?\\n(?:(?!---[ \\t]*\\r?\\n)[^\\n]*\\n)*---[ \\t]*\\r?\\n|(?!---[ \\t]*\\r?\\n(?:(?!---[ \\t]*\\r?\\n)[^\\n]*\\n)*---[ \\t]*\\r?\\n))(?:[ \\t]*(?:>[ \\t]*)*```[^\\n]*\\n(?:(?![ \\t]*(?:>[ \\t]*)*```)[^\\n]*\\n)*[ \\t]*(?:>[ \\t]*)*```[^\\n]*\\n|[ \\t]*(?:>[ \\t]*)*~~~[^\\n]*\\n(?:(?![ \\t]*(?:>[ \\t]*)*~~~)[^\\n]*\\n)*[ \\t]*(?:>[ \\t]*)*~~~[^\\n]*\\n|(?![ \\t]*(?:>[ \\t]*)*(?:```|~~~))[^\\n]*\\n)*(?![ \\t]*(?:>[ \\t]*)*(?:```|~~~))(?:[^`\\n]|`[^`\\n]*`)*)(?:(?<!^[ \\t]*)—|—(?![ \\t]*$))",
      "flags": "gm",
      "replace": "–",
      "enabled": true
    },
    {
      "label": "Guillemets → straight quotes",
      "find": "(?=[«»])(?<=(?<![\\s\\S])(?:---[ \\t]*\\r?\\n(?:(?!---[ \\t]*\\r?\\n)[^\\n]*\\n)*---[ \\t]*\\r?\\n|(?!---[ \\t]*\\r?\\n(?:(?!---[ \\t]*\\r?\\n)[^\\n]*\\n)*---[ \\t]*\\r?\\n))(?:[ \\t]*(?:>[ \\t]*)*```[^\\n]*\\n(?:(?![ \\t]*(?:>[ \\t]*)*```)[^\\n]*\\n)*[ \\t]*(?:>[ \\t]*)*```[^\\n]*\\n|[ \\t]*(?:>[ \\t]*)*~~~[^\\n]*\\n(?:(?![ \\t]*(?:>[ \\t]*)*~~~)[^\\n]*\\n)*[ \\t]*(?:>[ \\t]*)*~~~[^\\n]*\\n|(?![ \\t]*(?:>[ \\t]*)*(?:```|~~~))[^\\n]*\\n)*(?![ \\t]*(?:>[ \\t]*)*(?:```|~~~))(?:[^`\\n]|`[^`\\n]*`)*)[«»]",
      "flags": "gm",
      "replace": "\"",
      "enabled": true
    },
    {
      "label": "Arrow -> →",
      "find": "(?=->)(?<=(?<![\\s\\S])(?:---[ \\t]*\\r?\\n(?:(?!---[ \\t]*\\r?\\n)[^\\n]*\\n)*---[ \\t]*\\r?\\n|(?!---[ \\t]*\\r?\\n(?:(?!---[ \\t]*\\r?\\n)[^\\n]*\\n)*---[ \\t]*\\r?\\n))(?:[ \\t]*(?:>[ \\t]*)*```[^\\n]*\\n(?:(?![ \\t]*(?:>[ \\t]*)*```)[^\\n]*\\n)*[ \\t]*(?:>[ \\t]*)*```[^\\n]*\\n|[ \\t]*(?:>[ \\t]*)*~~~[^\\n]*\\n(?:(?![ \\t]*(?:>[ \\t]*)*~~~)[^\\n]*\\n)*[ \\t]*(?:>[ \\t]*)*~~~[^\\n]*\\n|(?![ \\t]*(?:>[ \\t]*)*(?:```|~~~))[^\\n]*\\n)*(?![ \\t]*(?:>[ \\t]*)*(?:```|~~~))(?:[^`\\n]|`[^`\\n]*`)*)(?<!-)->",
      "flags": "gm",
      "replace": "→",
      "enabled": true
    },
    {
      "label": "Back arrow <- ←",
      "find": "(?=<-)(?<=(?<![\\s\\S])(?:---[ \\t]*\\r?\\n(?:(?!---[ \\t]*\\r?\\n)[^\\n]*\\n)*---[ \\t]*\\r?\\n|(?!---[ \\t]*\\r?\\n(?:(?!---[ \\t]*\\r?\\n)[^\\n]*\\n)*---[ \\t]*\\r?\\n))(?:[ \\t]*(?:>[ \\t]*)*```[^\\n]*\\n(?:(?![ \\t]*(?:>[ \\t]*)*```)[^\\n]*\\n)*[ \\t]*(?:>[ \\t]*)*```[^\\n]*\\n|[ \\t]*(?:>[ \\t]*)*~~~[^\\n]*\\n(?:(?![ \\t]*(?:>[ \\t]*)*~~~)[^\\n]*\\n)*[ \\t]*(?:>[ \\t]*)*~~~[^\\n]*\\n|(?![ \\t]*(?:>[ \\t]*)*(?:```|~~~))[^\\n]*\\n)*(?![ \\t]*(?:>[ \\t]*)*(?:```|~~~))(?:[^`\\n]|`[^`\\n]*`)*)<-",
      "flags": "gm",
      "replace": "←",
      "enabled": true
    },
    {
      "label": "Remove heading numbering",
      "find": "^(?=#)(?<=(?<![\\s\\S])(?:---[ \\t]*\\r?\\n(?:(?!---[ \\t]*\\r?\\n)[^\\n]*\\n)*---[ \\t]*\\r?\\n|(?!---[ \\t]*\\r?\\n(?:(?!---[ \\t]*\\r?\\n)[^\\n]*\\n)*---[ \\t]*\\r?\\n))(?:[ \\t]*(?:>[ \\t]*)*```[^\\n]*\\n(?:(?![ \\t]*(?:>[ \\t]*)*```)[^\\n]*\\n)*[ \\t]*(?:>[ \\t]*)*```[^\\n]*\\n|[ \\t]*(?:>[ \\t]*)*~~~[^\\n]*\\n(?:(?![ \\t]*(?:>[ \\t]*)*~~~)[^\\n]*\\n)*[ \\t]*(?:>[ \\t]*)*~~~[^\\n]*\\n|(?![ \\t]*(?:>[ \\t]*)*(?:```|~~~))[^\\n]*\\n)*(?![ \\t]*(?:>[ \\t]*)*(?:```|~~~))(?:[^`\\n]|`[^`\\n]*`)*)(#{1,6}\\s+)\\d+(?:\\.\\d+)*\\.?\\s+",
      "flags": "gm",
      "replace": "$1",
      "enabled": true
    },
    {
      "label": "Ellipsis",
      "find": "(?=\\.{3})(?<=(?<![\\s\\S])(?:---[ \\t]*\\r?\\n(?:(?!---[ \\t]*\\r?\\n)[^\\n]*\\n)*---[ \\t]*\\r?\\n|(?!---[ \\t]*\\r?\\n(?:(?!---[ \\t]*\\r?\\n)[^\\n]*\\n)*---[ \\t]*\\r?\\n))(?:[ \\t]*(?:>[ \\t]*)*```[^\\n]*\\n(?:(?![ \\t]*(?:>[ \\t]*)*```)[^\\n]*\\n)*[ \\t]*(?:>[ \\t]*)*```[^\\n]*\\n|[ \\t]*(?:>[ \\t]*)*~~~[^\\n]*\\n(?:(?![ \\t]*(?:>[ \\t]*)*~~~)[^\\n]*\\n)*[ \\t]*(?:>[ \\t]*)*~~~[^\\n]*\\n|(?![ \\t]*(?:>[ \\t]*)*(?:```|~~~))[^\\n]*\\n)*(?![ \\t]*(?:>[ \\t]*)*(?:```|~~~))(?:[^`\\n]|`[^`\\n]*`)*)\\.{3}",
      "flags": "gm",
      "replace": "…",
      "enabled": true
    },
    {
      "label": "Plus-minus",
      "find": "(?=\\+/-)(?<=(?<![\\s\\S])(?:---[ \\t]*\\r?\\n(?:(?!---[ \\t]*\\r?\\n)[^\\n]*\\n)*---[ \\t]*\\r?\\n|(?!---[ \\t]*\\r?\\n(?:(?!---[ \\t]*\\r?\\n)[^\\n]*\\n)*---[ \\t]*\\r?\\n))(?:[ \\t]*(?:>[ \\t]*)*```[^\\n]*\\n(?:(?![ \\t]*(?:>[ \\t]*)*```)[^\\n]*\\n)*[ \\t]*(?:>[ \\t]*)*```[^\\n]*\\n|[ \\t]*(?:>[ \\t]*)*~~~[^\\n]*\\n(?:(?![ \\t]*(?:>[ \\t]*)*~~~)[^\\n]*\\n)*[ \\t]*(?:>[ \\t]*)*~~~[^\\n]*\\n|(?![ \\t]*(?:>[ \\t]*)*(?:```|~~~))[^\\n]*\\n)*(?![ \\t]*(?:>[ \\t]*)*(?:```|~~~))(?:[^`\\n]|`[^`\\n]*`)*)\\+/-",
      "flags": "gm",
      "replace": "±",
      "enabled": true
    },
    {
      "label": "Less than or equal",
      "find": "(?=<=)(?<=(?<![\\s\\S])(?:---[ \\t]*\\r?\\n(?:(?!---[ \\t]*\\r?\\n)[^\\n]*\\n)*---[ \\t]*\\r?\\n|(?!---[ \\t]*\\r?\\n(?:(?!---[ \\t]*\\r?\\n)[^\\n]*\\n)*---[ \\t]*\\r?\\n))(?:[ \\t]*(?:>[ \\t]*)*```[^\\n]*\\n(?:(?![ \\t]*(?:>[ \\t]*)*```)[^\\n]*\\n)*[ \\t]*(?:>[ \\t]*)*```[^\\n]*\\n|[ \\t]*(?:>[ \\t]*)*~~~[^\\n]*\\n(?:(?![ \\t]*(?:>[ \\t]*)*~~~)[^\\n]*\\n)*[ \\t]*(?:>[ \\t]*)*~~~[^\\n]*\\n|(?![ \\t]*(?:>[ \\t]*)*(?:```|~~~))[^\\n]*\\n)*(?![ \\t]*(?:>[ \\t]*)*(?:```|~~~))(?:[^`\\n]|`[^`\\n]*`)*)<=",
      "flags": "gm",
      "replace": "≤",
      "enabled": true
    },
    {
      "label": "Greater than or equal",
      "find": "(?=>=)(?<=(?<![\\s\\S])(?:---[ \\t]*\\r?\\n(?:(?!---[ \\t]*\\r?\\n)[^\\n]*\\n)*---[ \\t]*\\r?\\n|(?!---[ \\t]*\\r?\\n(?:(?!---[ \\t]*\\r?\\n)[^\\n]*\\n)*---[ \\t]*\\r?\\n))(?:[ \\t]*(?:>[ \\t]*)*```[^\\n]*\\n(?:(?![ \\t]*(?:>[ \\t]*)*```)[^\\n]*\\n)*[ \\t]*(?:>[ \\t]*)*```[^\\n]*\\n|[ \\t]*(?:>[ \\t]*)*~~~[^\\n]*\\n(?:(?![ \\t]*(?:>[ \\t]*)*~~~)[^\\n]*\\n)*[ \\t]*(?:>[ \\t]*)*~~~[^\\n]*\\n|(?![ \\t]*(?:>[ \\t]*)*(?:```|~~~))[^\\n]*\\n)*(?![ \\t]*(?:>[ \\t]*)*(?:```|~~~))(?:[^`\\n]|`[^`\\n]*`)*)>=",
      "flags": "gm",
      "replace": "≥",
      "enabled": true
    },
    {
      "label": "Not equal",
      "find": "(?=!=)(?<=(?<![\\s\\S])(?:---[ \\t]*\\r?\\n(?:(?!---[ \\t]*\\r?\\n)[^\\n]*\\n)*---[ \\t]*\\r?\\n|(?!---[ \\t]*\\r?\\n(?:(?!---[ \\t]*\\r?\\n)[^\\n]*\\n)*---[ \\t]*\\r?\\n))(?:[ \\t]*(?:>[ \\t]*)*```[^\\n]*\\n(?:(?![ \\t]*(?:>[ \\t]*)*```)[^\\n]*\\n)*[ \\t]*(?:>[ \\t]*)*```[^\\n]*\\n|[ \\t]*(?:>[ \\t]*)*~~~[^\\n]*\\n(?:(?![ \\t]*(?:>[ \\t]*)*~~~)[^\\n]*\\n)*[ \\t]*(?:>[ \\t]*)*~~~[^\\n]*\\n|(?![ \\t]*(?:>[ \\t]*)*(?:```|~~~))[^\\n]*\\n)*(?![ \\t]*(?:>[ \\t]*)*(?:```|~~~))(?:[^`\\n]|`[^`\\n]*`)*)!=",
      "flags": "gm",
      "replace": "≠",
      "enabled": true
    },
    {
      "label": "Outline Label",
      "find": "(?=[ \\t]*[-*+][ \\t])(?<=(?<![\\s\\S])(?:---[ \\t]*\\r?\\n(?:(?!---[ \\t]*\\r?\\n)[^\\n]*\\n)*---[ \\t]*\\r?\\n|(?!---[ \\t]*\\r?\\n(?:(?!---[ \\t]*\\r?\\n)[^\\n]*\\n)*---[ \\t]*\\r?\\n))(?:[ \\t]*(?:>[ \\t]*)*```[^\\n]*\\n(?:(?![ \\t]*(?:>[ \\t]*)*```)[^\\n]*\\n)*[ \\t]*(?:>[ \\t]*)*```[^\\n]*\\n|[ \\t]*(?:>[ \\t]*)*~~~[^\\n]*\\n(?:(?![ \\t]*(?:>[ \\t]*)*~~~)[^\\n]*\\n)*[ \\t]*(?:>[ \\t]*)*~~~[^\\n]*\\n|(?![ \\t]*(?:>[ \\t]*)*(?:```|~~~))[^\\n]*\\n)*(?![ \\t]*(?:>[ \\t]*)*(?:```|~~~))(?:[^`\\n]|`[^`\\n]*`)*)^([ \\t]*)([-*+])[ \\t]+(?!\\[[ xX-]\\][ \\t]+)(?!>[ \\t]|\\d{4}-\\d{2}-\\d{2}(?:[T \\t:]|$))(\\*\\*)?([A-Za-zА-Яа-яЁё0-9][^*#\\[\\]()`:\\r\\n]{0,79}?)(?:\\3:|:\\3)[ \\t]+(.+)$",
      "flags": "gm",
      "replace": "$1$2 $3$4$3\\n$1\t$2 $5",
      "enabled": true
    },
    {
      "label": "Split semicolon list",
      "find": "(?<=^([ \\t]*)([-*+])[ \\t]+(?!>[ \\t]|\\d{4}-\\d{2}-\\d{2}(?:[T \\t:]|$))(?=[^\\r\\n]*;[^\\r\\n]*;)[^\\r\\n]*)(?<=(?<![\\s\\S])(?:---[ \\t]*\\r?\\n(?:(?!---[ \\t]*\\r?\\n)[^\\n]*\\n)*---[ \\t]*\\r?\\n|(?!---[ \\t]*\\r?\\n(?:(?!---[ \\t]*\\r?\\n)[^\\n]*\\n)*---[ \\t]*\\r?\\n))(?:[ \\t]*(?:>[ \\t]*)*```[^\\n]*\\n(?:(?![ \\t]*(?:>[ \\t]*)*```)[^\\n]*\\n)*[ \\t]*(?:>[ \\t]*)*```[^\\n]*\\n|[ \\t]*(?:>[ \\t]*)*~~~[^\\n]*\\n(?:(?![ \\t]*(?:>[ \\t]*)*~~~)[^\\n]*\\n)*[ \\t]*(?:>[ \\t]*)*~~~[^\\n]*\\n|(?![ \\t]*(?:>[ \\t]*)*(?:```|~~~))[^\\n]*\\n)*(?![ \\t]*(?:>[ \\t]*)*(?:```|~~~))(?:[^`\\n]|`[^`\\n]*`)*);[ \\t]*",
      "flags": "gm",
      "replace": "\\n$1$2 ",
      "enabled": true
    },
