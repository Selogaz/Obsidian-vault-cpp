filters:
  and:
    - file.path != this.file.path
    - or:
        - file.inFolder("base/categories")
        - file.inFolder("base/_meta-notes")
        - file.inFolder("base/_problems")
        - file.inFolder("base/_hierarchy")
    - or:
        - '!this.file.hasTag("system/category")'
        - or:
            - file.hasTag("category/" + this.file.name.replace(/ /g, "_"))
            - category.contains(link(this.file.name))
formulas:
  stats_high_note: file.name
  cover_image: image(cover)
  cover_sort: if(cover == null, 0, 1)
  backlinks: file.backlinks.length
  outlinks: file.links.length
  created_relative: created.relative()
  updated_relative: updated.relative()
  type: if(file.hasTag("system/category"), "Category", if(file.hasTag("system/high/meta"), "Meta-note", if(file.hasTag("system/high/problem"), "Problem", if(file.hasTag("system/high/hierarchy"), "Hierarchy", "Other"))))
  category_status: if(file.hasTag("system/category"), if(category.isEmpty(), "✅", "❌"), if(file.hasTag("system/high/meta"), if(!category.isEmpty(), "✅", "❌"), if(file.hasTag("system/high/problem"), if(!category.isEmpty(), "✅", "❌"), if(file.hasTag("system/high/hierarchy"), if(!category.isEmpty(), "✅", "❌"), ""))))
  meta_status: if(file.hasTag("system/category"), if(meta.isEmpty(), "✅", "❌"), if(file.hasTag("system/high/meta"), if(meta.isEmpty(), "✅", "❌"), if(file.hasTag("system/high/problem"), if(!meta.isEmpty(), "✅", "❌"), if(file.hasTag("system/high/hierarchy"), "✅", ""))))
  problem_status: if(file.hasTag("system/high/hierarchy"), "✅", if(problem.isEmpty(), "✅", "❌"))
  category_type_valid: if(category.isEmpty(), "✅", if(list(category).filter(value.isType("link") && value.asFile().hasTag("system/category")).length == list(category).length, "✅", "❌"))
  meta_type_valid: if(meta.isEmpty(), "✅", if(list(meta).filter(value.isType("link") && value.asFile().hasTag("system/high/meta")).length == list(meta).length, "✅", "❌"))
  problem_type_valid: if(problem.isEmpty(), "✅", if(list(problem).filter(value.isType("link") && value.asFile().hasTag("system/high/problem")).length == list(problem).length, "✅", "❌"))
  category_valid: if(formula.category_status == "❌" || formula.category_type_valid == "❌", "❌", "✅")
  meta_valid: if(formula.meta_status == "❌" || formula.meta_type_valid == "❌", "❌", "✅")
  problem_valid: if(formula.problem_status == "❌" || formula.problem_type_valid == "❌", "❌", "✅")
properties:
  formula.stats_high_note:
    displayName: 🗂️ high notes
  formula.category_valid:
    displayName: ✓
  formula.meta_valid:
    displayName: ✓
  formula.problem_valid:
    displayName: ✓
  note.cover:
    displayName: 🖼️ cover
  formula.cover_image:
    displayName: 🖼️
  file.name:
    displayName: 🔤 title
  note.addition:
    displayName: ➕
  note.relevant:
    displayName: 📌
  note.category:
    displayName: 🗺️ category
  note.meta:
    displayName: 🔎 meta
  note.problem:
    displayName: ⚡ problem
  formula.backlinks:
    displayName: 🔽
  formula.outlinks:
    displayName: ⬆️
  formula.created_relative:
    displayName: 🆕 created
  formula.updated_relative:
    displayName: 🔄 updated
  formula.type:
    displayName: 🗄️ type
  formula.category_status:
    displayName: structure
  formula.meta_status:
    displayName: ✓
  formula.problem_status:
    displayName: ✓
  formula.category_type_valid:
    displayName: type
  formula.meta_type_valid:
    displayName: 🏷️
  formula.problem_type_valid:
    displayName: 🏷️
views:
  - type: table
    name: ⚙️ All Notes
    order:
      - relevant
      - formula.backlinks
      - formula.outlinks
      - file.name
      - addition
      - category
      - meta
      - problem
      - formula.created_relative
      - formula.updated_relative
    sort:
      - property: relevant
        direction: DESC
      - property: formula.type
        direction: DESC
      - property: category
        direction: ASC
      - property: meta
        direction: ASC
      - property: problem
        direction: ASC
      - property: formula.created_relative
        direction: DESC
    columnSize:
      file.name: 530
      note.addition: 90
      note.relevant: 1
      formula.backlinks: 1
      formula.outlinks: 1
      formula.created_relative: 140
      formula.updated_relative: 140
  - type: table
    name: ———
    filters:
      and:
        - "false"
    order:
      - file.name
  - type: table
    name: "🗄️ Group: By Type"
    groupBy:
      property: formula.type
      direction: DESC
    order:
      - relevant
      - formula.backlinks
      - formula.outlinks
      - file.name
      - addition
      - category
      - meta
      - problem
      - formula.created_relative
      - formula.updated_relative
    sort:
      - property: relevant
        direction: DESC
      - property: category
        direction: ASC
      - property: meta
        direction: ASC
      - property: problem
        direction: ASC
      - property: formula.created_relative
        direction: DESC
    columnSize:
      file.name: 530
      note.addition: 90
      note.relevant: 1
      formula.backlinks: 1
      formula.outlinks: 1
      formula.created_relative: 140
      formula.updated_relative: 140
  - type: table
    name: ———
    filters:
      and:
        - "false"
    order:
      - file.name
  - type: table
    name: "🗺️ Type: Categories"
    filters:
      and:
        - file.inFolder("base/categories")
    order:
      - relevant
      - formula.backlinks
      - formula.outlinks
      - file.name
    sort:
      - property: relevant
        direction: DESC
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 530
      note.relevant: 1
      formula.backlinks: 1
      formula.outlinks: 1
  - type: table
    name: "🔎 Type: Meta-notes"
    filters:
      and:
        - file.inFolder("base/_meta-notes")
    order:
      - relevant
      - formula.backlinks
      - formula.outlinks
      - file.name
      - addition
      - category
      - formula.created_relative
      - formula.updated_relative
    sort:
      - property: relevant
        direction: DESC
      - property: category
        direction: ASC
      - property: formula.created_relative
        direction: DESC
    columnSize:
      file.name: 530
      note.addition: 90
      note.relevant: 1
      formula.backlinks: 1
      formula.outlinks: 1
      formula.created_relative: 140
      formula.updated_relative: 140
  - type: table
    name: "⚡ Type: Problems"
    filters:
      and:
        - file.inFolder("base/_problems")
    order:
      - relevant
      - formula.backlinks
      - formula.outlinks
      - file.name
      - addition
      - category
      - meta
      - formula.created_relative
      - formula.updated_relative
    sort:
      - property: relevant
        direction: DESC
      - property: category
        direction: ASC
      - property: meta
        direction: ASC
      - property: formula.created_relative
        direction: DESC
    columnSize:
      file.name: 530
      note.addition: 90
      note.relevant: 1
      formula.backlinks: 1
      formula.outlinks: 1
      formula.created_relative: 140
      formula.updated_relative: 140
  - type: table
    name: "🧬 Type: Hierarchies"
    filters:
      and:
        - file.inFolder("base/_hierarchy")
    order:
      - relevant
      - formula.backlinks
      - formula.outlinks
      - file.name
      - addition
      - category
      - meta
      - problem
      - formula.created_relative
      - formula.updated_relative
    sort:
      - property: relevant
        direction: DESC
      - property: category
        direction: ASC
      - property: meta
        direction: ASC
      - property: problem
        direction: ASC
      - property: formula.created_relative
        direction: DESC
    columnSize:
      file.name: 530
      note.addition: 90
      note.relevant: 1
      formula.backlinks: 1
      formula.outlinks: 1
      formula.created_relative: 140
      formula.updated_relative: 140
  - type: table
    name: ———
    filters:
      and:
        - "false"
    order:
      - file.name
  - type: table
    name: "🗺️ Group: By Category"
    filters:
      and:
        - "!category.isEmpty()"
    groupBy:
      property: category
      direction: ASC
    order:
      - relevant
      - formula.backlinks
      - formula.outlinks
      - file.name
      - addition
      - category
      - meta
      - problem
      - formula.created_relative
      - formula.updated_relative
    sort:
      - property: relevant
        direction: DESC
    columnSize:
      file.name: 530
      note.addition: 90
      note.relevant: 1
      formula.backlinks: 1
      formula.outlinks: 1
      formula.created_relative: 140
      formula.updated_relative: 140
  - type: table
    name: "🔎 Group: By Meta"
    filters:
      and:
        - "!meta.isEmpty()"
    groupBy:
      property: meta
      direction: ASC
    order:
      - relevant
      - formula.backlinks
      - formula.outlinks
      - file.name
      - addition
      - category
      - problem
      - formula.created_relative
      - formula.updated_relative
    sort:
      - property: relevant
        direction: DESC
    columnSize:
      file.name: 530
      note.addition: 90
      note.relevant: 1
      formula.backlinks: 1
      formula.outlinks: 1
      formula.created_relative: 140
      formula.updated_relative: 140
  - type: table
    name: "⚡ Group: By Problem"
    filters:
      and:
        - "!problem.isEmpty()"
    groupBy:
      property: problem
      direction: ASC
    order:
      - relevant
      - formula.backlinks
      - formula.outlinks
      - file.name
      - addition
      - category
      - meta
      - formula.created_relative
      - formula.updated_relative
    sort:
      - property: relevant
        direction: DESC
    columnSize:
      file.name: 530
      note.addition: 90
      note.relevant: 1
      formula.backlinks: 1
      formula.outlinks: 1
      formula.created_relative: 140
      formula.updated_relative: 140
  - type: structure
    name: "🌳 Structure: Tree"
    layout: graph
    direction: right
    edgeLabels: true
    inherit:
      - category
      - meta
      - problem
    types:
      Category:
        tag: system/category
        folder: base/categories
        children:
          Meta-note: category
          Hierarchy: category
      Meta-note:
        tag: system/high/meta
        folder: base/_meta-notes
        children:
          Problem: meta
          Hierarchy: meta
      Problem:
        tag: system/high/problem
        folder: base/_problems
        children:
          Hierarchy: problem
      Hierarchy:
        tag: system/high/hierarchy
        children:
          Hierarchy: file.backlinks
  - type: table
    name: ———
    filters:
      and:
        - "false"
    order:
      - file.name
  - type: chart-bar
    name: "📈 Statistics: By Types"
    x: formula.type
    y:
      - formula.stats_high_note
    aggregate:formula.stats_high_note: Count
    show-labels: true
  - type: table
    name: ———
    filters:
      and:
        - "false"
    order:
      - file.name
  - type: table
    name: ✅ Structure Validation
    filters:
      or:
        - formula.category_valid == "❌"
        - formula.meta_valid == "❌"
        - formula.problem_valid == "❌"
    order:
      - file.name
      - formula.category_valid
      - category
      - formula.meta_valid
      - meta
      - formula.problem_valid
      - problem
    sort:
      - property: formula.type
        direction: DESC
      - property: formula.category_valid
        direction: DESC
      - property: formula.meta_valid
        direction: DESC
      - property: formula.problem_valid
        direction: DESC
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 350
      formula.type: 120
      formula.category_valid: 1
      formula.meta_valid: 1
      formula.problem_valid: 1
      note.category: 180
      note.meta: 180
      note.problem: 180
  - type: table
    name: ⬜ Uncovered
    groupBy:
      property: formula.type
      direction: ASC
    order:
      - formula.cover_image
      - file.name
      - cover
    sort:
      - property: formula.cover_sort
        direction: ASC
