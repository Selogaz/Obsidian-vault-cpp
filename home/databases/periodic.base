filters:
  and:
    - or:
        - file.inFolder("periodic/daily")
        - file.inFolder("periodic/weekly")
        - file.inFolder("periodic/monthly")
        - file.inFolder("periodic/quarterly")
        - file.inFolder("periodic/yearly")
    - '!file.hasTag("mark/ignore")'
formulas:
  month_group: file.name.slice(0, 7)
  year: file.name.slice(0, 4)
  updated_relative: updated.relative()
  existing_links: file.links.map(value.asFile()).filter(value.isTruthy())
  overall: if(file.hasProperty("focus") && file.hasProperty("learn") && file.hasProperty("routine") && file.hasProperty("move") && file.hasProperty("connect") && file.hasProperty("rest"), ((number(focus) + number(learn) + number(routine) + number(move) + number(connect) + number(rest)) / 6).round(1), null)
  day_quality: if(formula.overall.isEmpty(), null, if(formula.overall >= 7, "Great", if(formula.overall >= 5, "Good", if(formula.overall >= 3, "Okay", "Low"))))
  unique_day: if(description.isEmpty(), null, 1)
properties:
  note.reviewed:
    displayName: ✅️
  formula.updated_relative:
    displayName: 🔄 updated
  formula.month_group:
    displayName: 🗓️ month
  note.description:
    displayName: 🦄 description (text)
  file.name:
    displayName: 📅 period
  formula.day_quality:
    displayName: ✨ day quality
  formula.unique_day:
    displayName: 🦄 unique days
  formula.existing_links:
    displayName: 🔗 links
  note.focus:
    displayName: 🧿 focus
  note.learn:
    displayName: 💡 learn
  note.routine:
    displayName: 🔄 routine
  note.move:
    displayName: 🧗 move
  note.connect:
    displayName: 💬 connect
  note.rest:
    displayName: 🌙 rest
views:
  - type: table
    name: 🇩ays
    filters:
      and:
        - file.inFolder("periodic/daily")
    groupBy:
      property: formula.month_group
      direction: DESC
    order:
      - reviewed
      - file.name
      - formula.updated_relative
      - focus
      - learn
      - routine
      - move
      - connect
      - rest
      - description
    sort:
      - property: file.name
        direction: DESC
    columnSize:
      file.name: 145
      note.focus: 90
      note.learn: 90
      note.routine: 100
      note.move: 90
      note.connect: 110
      note.rest: 80
  - type: table
    name: 🇼eeks
    filters:
      and:
        - file.inFolder("periodic/weekly")
    groupBy:
      property: formula.year
      direction: DESC
    order:
      - reviewed
      - file.name
      - formula.updated_relative
      - description
    sort:
      - property: file.name
        direction: DESC
    columnSize:
      file.name: 145
  - type: table
    name: 🇲onths
    filters:
      and:
        - file.inFolder("periodic/monthly")
    groupBy:
      property: formula.year
      direction: DESC
    order:
      - reviewed
      - file.name
      - formula.updated_relative
      - description
    sort:
      - property: file.name
        direction: DESC
    columnSize:
      file.name: 145
  - type: table
    name: 🇶uarters
    filters:
      and:
        - file.inFolder("periodic/quarterly")
    groupBy:
      property: formula.year
      direction: DESC
    order:
      - reviewed
      - file.name
      - formula.updated_relative
      - description
    sort:
      - property: file.name
        direction: DESC
    columnSize:
      file.name: 145
  - type: table
    name: 🇾ears
    filters:
      and:
        - file.inFolder("periodic/yearly")
    order:
      - reviewed
      - file.name
      - formula.updated_relative
      - description
    sort:
      - property: file.name
        direction: DESC
    columnSize:
      file.name: 145
  - type: table
    name: ———
    filters:
      and:
        - "false"
    order:
      - file.name
  - type: periodic-review
    name: 👁 Review
    showQuarterly: true
    showYearly: true
  - type: table
    name: "👁 Days: To Review"
    filters:
      and:
        - file.inFolder("periodic/daily")
        - "!reviewed"
        - date(file.name) < today()
        - date(file.name) >= today() - "365d"
    order:
      - reviewed
      - file.name
      - formula.updated_relative
      - focus
      - learn
      - routine
      - move
      - connect
      - rest
      - description
    sort:
      - property: file.name
        direction: DESC
    columnSize:
      file.name: 145
      note.focus: 90
      note.learn: 90
      note.routine: 100
      note.move: 90
      note.connect: 110
      note.rest: 80
  - type: table
    name: "👁 Weeks: To Review"
    filters:
      and:
        - file.inFolder("periodic/weekly")
        - "!reviewed"
        - file.name < today().format("GGGG-[W]WW")
    order:
      - reviewed
      - file.name
      - formula.updated_relative
    sort:
      - property: file.name
        direction: DESC
    columnSize:
      file.name: 145
  - type: table
    name: "👁 Months: To Review"
    filters:
      and:
        - file.inFolder("periodic/monthly")
        - "!reviewed"
        - file.name < today().format("YYYY-MM")
    order:
      - reviewed
      - file.name
      - formula.updated_relative
    sort:
      - property: file.name
        direction: DESC
    columnSize:
      file.name: 145
  - type: table
    name: "👁 Quarters: To Review"
    filters:
      and:
        - file.inFolder("periodic/quarterly")
        - "!reviewed"
        - file.name < today().format("YYYY-[Q]Q")
    order:
      - reviewed
      - file.name
      - formula.updated_relative
    sort:
      - property: file.name
        direction: DESC
    columnSize:
      file.name: 145
  - type: table
    name: "👁 Years: To Review"
    filters:
      and:
        - file.inFolder("periodic/yearly")
        - "!reviewed"
        - file.name < today().format("YYYY")
    order:
      - reviewed
      - file.name
      - formula.updated_relative
    sort:
      - property: file.name
        direction: DESC
    columnSize:
      file.name: 145
  - type: life-tracker
    name: 📈 Statistics
    filters:
      and:
        - file.inFolder("periodic/daily")
    order:
      - focus
      - learn
      - move
      - connect
      - routine
      - rest
      - reviewed
      - formula.overall
      - formula.day_quality
      - formula.unique_day
    columnConfigs:
      note.focus:
        - id: e1d85ee5-6abb-46c9-bc85-508fb7c02bc0
          propertyId: note.focus
          visualizationType: heatmap
          displayName: 🧿 focus
          configuredAt: 1789450938468
          scale:
            min: 0
            max: 10
          colorScheme:
            kind: discrete
            empty: var(--background-modifier-border)
            mapping:
              "0": "#bb584f"
              "1": "#c4654b"
              "2": "#cb7248"
              "3": "#d18246"
              "4": "#d39449"
              "5": "#d4a552"
              "6": "#c1ab4f"
              "7": "#abb055"
              "8": "#8faf5c"
              "9": "#6ea75f"
              "10": "#499e64"
            fallback: "#cccccc"
