filters:
  and:
    - file.inFolder("sources")
    - '!file.hasTag("mark/log")'
    - or:
        - '!this.file.hasTag("system/category")'
        - or:
            - file.hasTag("category/" + this.file.name.replace(/ /g, "_"))
            - category.contains(link(this.file.name))
formulas:
  type: file.tags.filter(value.startsWith("#source/"))[0].replace(/^.*\//, '')
  kanban: if(status.contains("⚛"), "① ⚛ Atom", if(status.contains("🟦"), "② 🟦 In Progress", if(status.contains("🟥"), "③ 🟥 ToDo", if(status.contains("📥"), "④ 📥 Inbox", "⑤ Other"))))
  scientificity: if(scientificity.contains("🅰️"), "① 🅰️ primary research", if(scientificity.contains("🅱️"), "② 🅱️ secondary research", if(scientificity.contains("👓"), "③ 👓 expert/industry", if(scientificity.contains("📢"), "④ 📢 popular science/journalism", if(scientificity.contains("💬"), "⑤ 💬 opinion/unverified", "⑥ Other")))))
  rating: if(rating.contains("🌕"), "① 🌕 masterpiece", if(rating.contains("🌔"), "② 🌔 great", if(rating.contains("🌓"), "③ 🌓 good", if(rating.contains("🌒"), "④ 🌒 mediocre", if(rating.contains("🌑"), "⑤ 🌑 poor", "⑥ Other")))))
  backlinks: file.backlinks.length
  outlinks: file.links.length
  created_relative: created.relative()
  updated_relative: updated.relative()
  category_status: if(!category.isEmpty(), "✅", "❌")
  category_type_valid: if(category.isEmpty(), "✅", if(list(category).filter(value.isType("link") && value.asFile().hasTag("system/category")).length == list(category).length, "✅", "❌"))
  meta_type_valid: if(meta.isEmpty(), "✅", if(list(meta).filter(value.isType("link") && value.asFile().hasTag("system/high/meta")).length == list(meta).length, "✅", "❌"))
  problem_type_valid: if(problem.isEmpty(), "✅", if(list(problem).filter(value.isType("link") && value.asFile().hasTag("system/high/problem")).length == list(problem).length, "✅", "❌"))
  creator_type_valid: if(creator.isEmpty(), "✅", if(list(creator).filter(value.isType("link") && value.asFile().tags.filter(value.startsWith("#creator/") || value.startsWith("#contact/")).length > 0).length == list(creator).length, "✅", "❌"))
  production_type_valid: if(production.isEmpty(), "✅", if(list(production).filter(value.isType("link") && value.asFile().tags.filter(value.startsWith("#production/")).length > 0).length == list(production).length, "✅", "❌"))
  creator_category_valid: if(creator.isEmpty(), "✅", if(list(creator).filter(value.isType("link") && value.asFile() && list(value.asFile().properties.category).filter(list(category).contains(value)).isEmpty()).isEmpty(), "✅", "❌"))
  production_category_valid: if(production.isEmpty(), "✅", if(list(production).filter(value.isType("link") && value.asFile() && list(value.asFile().properties.category).filter(list(category).contains(value)).isEmpty()).isEmpty(), "✅", "❌"))
  published_year: if(published, published.toString().slice(0, 4), "")
  cover_image: image(cover)
  cover_sort: if(cover == null, 0, 1)
  category_valid: if(formula.category_type_valid == "❌", "❌", "✅")
  meta_valid: if(formula.meta_type_valid == "❌", "❌", "✅")
  problem_valid: if(formula.problem_type_valid == "❌", "❌", "✅")
  creator_valid: if(formula.creator_type_valid == "❌" || formula.creator_category_valid == "❌", "❌", "✅")
  production_valid: if(formula.production_type_valid == "❌" || formula.production_category_valid == "❌", "❌", "✅")
properties:
  formula.category_valid:
    displayName: ✓
  formula.meta_valid:
    displayName: ✓
  formula.problem_valid:
    displayName: ✓
  formula.creator_valid:
    displayName: ✓
  formula.production_valid:
    displayName: ✓
  formula.type:
    displayName: 🗄️ type
  note.zotero:
    displayName: 🇿
  note.addition:
    displayName: ➕
  note.status:
    displayName: 💯
  note.scientificity:
    displayName: 🅰️
  note.rating:
    displayName: 🌕️
  note.category:
    displayName: 🗺️ category
  note.meta:
    displayName: 🔎 meta
  note.problem:
    displayName: ⚡ problem
  note.creator:
    displayName: 👨 creator
  note.production:
    displayName: 🏬 production
  note.url:
    displayName: 🔗 url
  note.tags:
    displayName: 🏷️ tags
  note.aliases:
    displayName: 🔖 aliases
  note.genre:
    displayName: 🎭 Genre
  note.published:
    displayName: 🗓️ Year
  file.name:
    displayName: 🔤 title
  formula.backlinks:
    displayName: 🔽
  formula.outlinks:
    displayName: ⬆️
  formula.created_relative:
    displayName: 🆕 created
  formula.updated_relative:
    displayName: 🔄 updated
  formula.category_status:
    displayName: structure
  formula.category_type_valid:
    displayName: type
  formula.meta_type_valid:
    displayName: 🏷️
  formula.problem_type_valid:
    displayName: 🏷️
  formula.creator_type_valid:
    displayName: 🏷️
  formula.creator_category_valid:
    displayName: 🗺️
  formula.production_type_valid:
    displayName: 🏷️
  formula.production_category_valid:
    displayName: 🗺️
  note.cover:
    displayName: 🖼️ cover
  formula.cover_image:
    displayName: 🖼️
views:
  - type: table
    name: "📊 All: Short View"
    order:
      - file.name
      - addition
      - zotero
      - status
      - scientificity
      - rating
      - category
      - meta
      - problem
      - creator
      - production
      - url
      - tags
      - aliases
    sort:
      - property: formula.kanban
        direction: ASC
      - property: formula.created_relative
        direction: DESC
    columnSize:
      file.name: 530
      note.addition: 90
      note.zotero: 1
      note.status: 1
      note.scientificity: 1
      note.rating: 1
  - type: table
    name: "📊 All: Extended View"
    order:
      - formula.backlinks
      - formula.outlinks
      - formula.created_relative
      - formula.updated_relative
      - formula.type
      - file.name
      - addition
      - zotero
      - status
      - scientificity
      - rating
      - category
      - meta
      - problem
      - creator
      - production
      - url
      - tags
      - aliases
    sort:
      - property: formula.kanban
        direction: ASC
      - property: formula.created_relative
        direction: DESC
    columnSize:
      file.name: 530
      formula.backlinks: 1
      formula.outlinks: 1
      note.addition: 90
      note.zotero: 1
      note.status: 1
      note.scientificity: 1
      note.rating: 1
      formula.created_relative: 140
      formula.updated_relative: 140
  - type: table
    name: ———
    filters:
      and:
        - "false"
    order:
      - file.name
  - type: table
    name: "📋 Workflow: Kanban (v)"
    filters:
      and:
        - '!status.contains("⬛")'
        - '!status.contains("🟩")'
    groupBy:
      property: formula.kanban
      direction: ASC
    order:
      - file.name
      - addition
      - zotero
      - status
      - scientificity
      - rating
      - category
      - meta
      - problem
      - creator
      - production
      - url
    sort:
      - property: formula.created_relative
        direction: DESC
    columnSize:
      file.name: 530
      note.addition: 90
      note.zotero: 1
      note.status: 1
      note.scientificity: 1
      note.rating: 1
  - type: board-view
    name: "📋 Workflow: Kanban (h)"
    filters:
      and:
        - '!status.contains("⬛")'
        - '!status.contains("🟩")'
    order:
      - file.name
      - formula.type
      - scientificity
      - category
    groupProperty: note.status
    hideEmptyGroups: false
    hiddenGroups:
      - Empty Group
      - 💡
      - 🧠
      - 🖍
      - 🔎
      - 📦
      - 📋
      - ⚙️
      - 📢
      - ❄
      - ⬛
      - 🟩
    columnOrder:
      - 📥
      - 🟥
      - 🟦
      - ⚛
    colorCells: false
    colorHeaders: false
    colorCards: true
    hideEmptySubGroups: false
    subGroupLabels:
      - Empty Group=default
    groupLabels:
      - 📥=📥 Inbox
      - 🟥=🟥 ToDo
      - 🟦=🟦 WIP
      - ⚛=⚛ Atom
    newNoteFolder:
      - sources
    newNoteTemplate:
      - templates/create/sources/source template.md
    newNoteOpen: true
    imageProperty: note.cover
    hideEmptyProperties: true
  - type: block-view
    name: "✅ Workflow: Inline Tasks"
    filters:
      and:
        - '!status.contains("⬛")'
        - '!status.contains("🟩")'
    filterTasks: true
    filterQuotes: false
    filterTasksType: incomplete
  - type: table
    name: "🗄️ Workflow: Group By Type"
    filters:
      and:
        - '!status.contains("⬛")'
        - '!status.contains("🟩")'
    groupBy:
      property: formula.type
      direction: ASC
    order:
      - file.name
      - addition
      - zotero
      - status
      - scientificity
      - rating
      - category
      - meta
      - problem
      - creator
      - production
      - url
    sort:
      - property: formula.kanban
        direction: ASC
      - property: formula.created_relative
        direction: DESC
    columnSize:
      file.name: 530
      note.addition: 90
      note.zotero: 1
      note.status: 1
      note.scientificity: 1
      note.rating: 1
  - type: table
    name: "🌕 Workflow: Rate"
    filters:
      and:
        - status.contains("🟩")
        - rating.isEmpty()
    groupBy:
      property: formula.type
      direction: ASC
    order:
      - file.name
      - status
      - rating
      - scientificity
      - creator
      - end
    sort:
      - property: end
        direction: DESC
    columnSize:
      file.name: 530
      note.status: 1
      note.rating: 1
      note.scientificity: 1
  - type: table
    name: "🅰️ Workflow: Classify"
    filters:
      and:
        - '!status.contains("⬛")'
        - scientificity.isEmpty()
    groupBy:
      property: formula.type
      direction: ASC
    order:
      - file.name
      - status
      - scientificity
      - rating
      - creator
      - production
    sort:
      - property: formula.created_relative
        direction: DESC
    columnSize:
      file.name: 530
      note.status: 1
      note.scientificity: 1
      note.rating: 1
  - type: table
    name: ———
    filters:
      and:
        - "false"
    order:
      - file.name
  - type: table
    name: "⬛ Status: Drop"
    filters:
      and:
        - status.contains("⬛")
    order:
      - file.name
      - addition
      - zotero
      - status
      - scientificity
      - rating
      - category
      - meta
      - problem
      - creator
      - production
