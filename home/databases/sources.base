  - type: table
    name: ———
    filters:
      and:
        - "false"
    order:
      - file.name
  - type: dynamic-views-grid
    name: "🖼️ Gallery: Covers"
    filters:
      and:
        - cover != null
    groupBy:
      property: formula.type
      direction: ASC
    order:
      - file.name
    sort:
      - property: formula.created_relative
        direction: DESC
    id: "f2u01j-🖼️ Gallery: Covers"
    displaySecondAsSubtitle: false
    fallbackToContent: false
    imageProperty: note.cover
    imageFormat: poster
    tint: dark
    posterInteractToReveal: true
    imageFit: contain
    imageRatio: 1.55
  - type: dynamic-views-grid
    name: "🖼️ Gallery: Genres"
    filters:
      and:
        - cover != null
        - genre != null
    groupBy:
      property: genre
      direction: ASC
    order:
      - file.name
    sort:
      - property: formula.created_relative
        direction: DESC
    displaySecondAsSubtitle: false
    fallbackToContent: false
    imageProperty: note.cover
    imageFormat: poster
    tint: dark
    posterInteractToReveal: true
    imageFit: contain
    imageRatio: 1.55
    id: "v5zhda-🖼️ Gallery: Genres"
  - type: table
    name: ———
    filters:
      and:
        - "false"
    order:
      - file.name
  - type: chart-bar
    name: "📈 Statistics: By Types"
    x: formula.type
    aggregate:file.name: Count
    show-labels: true
  - type: chart-bar
    name: "📈 Statistics: By Statuses"
    sort:
      - property: formula.kanban
        direction: ASC
    x: note.status
    aggregate:file.name: Count
    show-labels: true
  - type: chart-bar
    name: "📈 Statistics: By Ratings"
    x: note.rating
    aggregate:file.name: Count
    show-labels: true
    sync-y-axes: false
  - type: chart-bar
    name: "📈 Statistics: By Scientificity"
    x: note.scientificity
    aggregate:file.name: Count
    show-labels: true
    sync-y-axes: false
  - type: chart-bar
    name: "📈 Statistics: By Category"
    x: note.category
    aggregate:file.name: Count
    show-labels: true
    sync-y-axes: false
    show-percentages: false
  - type: chart-bar
    name: "📈 Statistics: By Published"
    filters:
      and:
        - published != null
    sort:
      - property: published
        direction: ASC
    x: formula.published_year
    aggregate:file.name: Count
    show-labels: true
    sync-y-axes: false
    show-percentages: false
  - type: table
    name: ———
    filters:
      and:
        - "false"
    order:
      - file.name
  - type: table
    name: ✅ Structure Validation
    filters:
      or:
        - formula.category_valid == "❌"
        - formula.meta_valid == "❌"
        - formula.problem_valid == "❌"
        - formula.creator_valid == "❌"
        - formula.production_valid == "❌"
    order:
      - file.name
      - formula.category_valid
      - category
      - formula.meta_valid
      - meta
      - formula.problem_valid
      - problem
      - formula.creator_valid
      - creator
      - formula.production_valid
      - production
    sort:
      - property: formula.category_valid
        direction: DESC
      - property: formula.meta_valid
        direction: DESC
      - property: formula.problem_valid
        direction: DESC
      - property: formula.creator_valid
        direction: DESC
      - property: formula.production_valid
        direction: DESC
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 350
      formula.category_valid: 1
      formula.meta_valid: 1
      formula.problem_valid: 1
      formula.creator_valid: 1
      formula.production_valid: 1
      note.category: 180
      note.meta: 180
      note.problem: 180
      note.creator: 180
      note.production: 180
  - type: table
    name: ⬜ Uncovered
    groupBy:
      property: formula.type
      direction: ASC
    order:
      - formula.cover_image
      - file.name
      - cover
    sort:
      - property: formula.cover_sort
        direction: ASC
